---
source: crates/foundation/tests/config_snapshots.rs
expression: "Render::new(\"\").template::<SimpleConfig>()"
---
# Service display name.
# env: NAME
name: foundation

# Port to bind.
# env: PORT
port: <required>

# Logging settings.
logging:

  # Enables JSON logging.
  # env: LOGGING__JSON
  json: false

  # Optional extra targets.
  # env: LOGGING__EXTRA_TARGETS
  extra_targets: []

# Optional labels.
# env: LABELS
labels: {}
